{
  "name": "agent-review",
  "displayName": "Agent Review",
  "description": "Displays AI-generated code review comments inline using the VSCode Comments API",
  "version": "0.5.0",
  "publisher": "jaikathuria",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaikathuria/agent-reviews.git"
  },
  "bugs": {
    "url": "https://github.com/jaikathuria/agent-reviews/issues"
  },
  "homepage": "https://github.com/jaikathuria/agent-reviews#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.reviews/*-pr-*-review-comments.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentReview.reload",
        "title": "Agent Review: Reload Comments"
      },
      {
        "command": "agentReview.clear",
        "title": "Agent Review: Clear All Comments"
      },
      {
        "command": "agentReview.loadFile",
        "title": "Agent Review: Load Review File..."
      },
      {
        "command": "agentReview.deleteComment",
        "title": "Delete Comment",
        "icon": "$(trash)"
      },
      {
        "command": "agentReview.editComment",
        "title": "Edit Comment",
        "icon": "$(edit)"
      },
      {
        "command": "agentReview.saveComment",
        "title": "Save",
        "icon": "$(check)"
      },
      {
        "command": "agentReview.cancelEdit",
        "title": "Cancel",
        "icon": "$(close)"
      },
      {
        "command": "agentReview.changeSeverity",
        "title": "Change Severity",
        "icon": "$(tag)"
      },
      {
        "command": "agentReview.postToGitHub",
        "title": "Agent Review: Post Review to GitHub",
        "icon": "$(github)"
      },
      {
        "command": "agentReview.postCommentToGitHub",
        "title": "Post Comment to GitHub",
        "icon": "$(github)"
      },
      {
        "command": "agentReview.switchReview",
        "title": "Agent Review: Switch Review File"
      },
      {
        "command": "agentReview.generateAgentInstructions",
        "title": "Agent Review: Generate Agent Instructions"
      },
      {
        "command": "agentReview.openFileDiff",
        "title": "Agent Review: Open File Diff"
      },
      {
        "command": "agentReview.nextComment",
        "title": "Agent Review: Next Comment"
      },
      {
        "command": "agentReview.previousComment",
        "title": "Agent Review: Previous Comment"
      },
      {
        "command": "agentReview.refreshPROverview",
        "title": "Agent Review: Refresh PR Overview",
        "icon": "$(refresh)"
      },
      {
        "command": "agentReview.openPROnGitHub",
        "title": "Open on GitHub",
        "icon": "$(link-external)"
      },
      {
        "command": "agentReview.triggerAgentReview",
        "title": "Trigger Agent Review",
        "icon": "$(sparkle)"
      }
    ],
    "keybindings": [
      {
        "command": "agentReview.reload",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r"
      },
      {
        "command": "agentReview.postToGitHub",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g"
      },
      {
        "command": "agentReview.switchReview",
        "key": "ctrl+shift+w",
        "mac": "cmd+shift+w"
      },
      {
        "command": "agentReview.postCommentToGitHub",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "commentIsVisible"
      },
      {
        "command": "agentReview.nextComment",
        "key": "ctrl+shift+]",
        "mac": "cmd+shift+]"
      },
      {
        "command": "agentReview.previousComment",
        "key": "ctrl+shift+[",
        "mac": "cmd+shift+["
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agent-reviews",
          "title": "Agent Reviews",
          "icon": "icons/sidebar.svg"
        }
      ]
    },
    "views": {
      "agent-reviews": [
        {
          "id": "agentReview.prOverview",
          "name": "PR Reviews"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentReview.prOverview",
        "contents": "No review files loaded.\n[Load Review File](command:agentReview.loadFile)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentReview.refreshPROverview",
          "when": "view == agentReview.prOverview",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "agentReview.triggerAgentReview",
          "when": "view == agentReview.prOverview && viewItem == pendingPR",
          "group": "inline@1"
        },
        {
          "command": "agentReview.openPROnGitHub",
          "when": "view == agentReview.prOverview && viewItem =~ /^(reviewedPR|pendingPR)$/",
          "group": "inline@2"
        }
      ],
      "comments/comment/title": [
        {
          "command": "agentReview.editComment",
          "when": "comment == agentReview && commentController =~ /^agent-review-/",
          "group": "inline@1"
        },
        {
          "command": "agentReview.changeSeverity",
          "when": "comment == agentReview && commentController =~ /^agent-review-/",
          "group": "inline@2"
        },
        {
          "command": "agentReview.deleteComment",
          "when": "comment == agentReview && commentController =~ /^agent-review-/",
          "group": "inline@3"
        },
        {
          "command": "agentReview.postCommentToGitHub",
          "when": "comment == agentReview && commentController =~ /^agent-review-/",
          "group": "inline@4"
        }
      ],
      "comments/comment/context": [
        {
          "command": "agentReview.saveComment",
          "when": "comment == agentReviewEditing && commentController =~ /^agent-review-/",
          "group": "inline@1"
        },
        {
          "command": "agentReview.cancelEdit",
          "when": "comment == agentReviewEditing && commentController =~ /^agent-review-/",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "Agent Review",
      "properties": {
        "agentReview.agent": {
          "type": "string",
          "default": "claude",
          "enum": ["claude", "codex", "custom"],
          "enumDescriptions": [
            "Claude Code (claude CLI)",
            "OpenAI Codex CLI",
            "Custom command template (set agentReview.agentCommand)"
          ],
          "description": "Which AI agent to use for PR reviews."
        },
        "agentReview.agentCommand": {
          "type": "string",
          "default": "",
          "description": "Custom command template. Available variables: ${repo}, ${number}, ${title}, ${base}, ${head}, ${reviewsDir}, ${outputFilename}"
        },
        "agentReview.agentRunIn": {
          "type": "string",
          "default": "terminal",
          "enum": ["terminal", "background"],
          "enumDescriptions": [
            "Run in a visible VS Code terminal (recommended — see agent progress)",
            "Run as a background process with progress notification"
          ],
          "description": "Where the agent process runs."
        },
        "agentReview.agentTimeoutSeconds": {
          "type": "number",
          "default": 300,
          "description": "Timeout in seconds for background agent execution. 0 = no timeout. Only applies when agentRunIn is 'background'."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && vsce package"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.7.1",
    "typescript": "^5.3.0"
  }
}
